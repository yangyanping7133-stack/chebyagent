<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_updater"
        android:label="@string/app_name"
        android:supportsRtl="true">
        <receiver
            android:name=".ChebyDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- DUMP is a platform signature permission held by ADB shell. It keeps the
             local maintenance entry point unavailable to ordinary phone apps. -->
        <receiver
            android:name=".UpdateCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.cheby.codex.updater.action.PREPARE" />
                <action android:name="com.cheby.codex.updater.action.INSTALL" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".UpdateStatusProvider"
            android:authorities="com.cheby.codex.updater.status"
            android:exported="true"
            android:readPermission="android.permission.DUMP"
            android:writePermission="android.permission.DUMP" />

        <receiver
            android:name=".UpdateResultReceiver"
            android:exported="false" />
    </application>
</manifest>

# Public, non-secret inputs. Never put pairing or Node credentials here.
CHEBY_RELAY_IMAGE=sha256:replace-with-reviewed-local-image-id
CHEBY_RELAY_HOST=relay.example.com
# Exact immediate TLS proxy network as seen inside the Relay container. Never
# use 0.0.0.0/0, ::/0, or a broad untrusted Docker/VPC range.
CHEBY_RELAY_TRUSTED_PROXY_CIDRS=replace-with-exact-proxy-cidr
# The ingress must delete any client-supplied copy, then set exactly one value.
CHEBY_RELAY_CLIENT_IP_HEADER=x-relay-client-ip
CHEBY_RELAY_LOOPBACK_PORT=18080
CHEBY_RELAY_DATA_DIR=/var/lib/chebycodex-relay/data
CHEBY_RELAY_BOOTSTRAP_DIR=/etc/chebycodex-relay/bootstrap
CHEBY_RELAY_MEMORY=1g
CHEBY_RELAY_CPUS=1.0

worker_processes auto;
worker_rlimit_nofile 2048;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
    multi_accept off;
}

http {
    access_log off;
    server_tokens off;

    client_header_timeout 10s;
    client_body_timeout 15s;
    client_header_buffer_size 1k;
    large_client_header_buffers 2 8k;
    client_body_buffer_size 16k;
    client_max_body_size 64k;
    keepalive_timeout 15s;
    keepalive_requests 100;
    send_timeout 60s;
    lingering_timeout 5s;
    reset_timedout_connection on;

    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;

    limit_req_status 429;
    limit_conn_status 429;
    limit_req_log_level warn;
    limit_conn_log_level warn;

    limit_req_zone $binary_remote_addr zone=api_source:10m rate=120r/m;
    limit_req_zone $server_addr zone=api_global:10m rate=600r/m;
    limit_req_zone $binary_remote_addr zone=pair_source:10m rate=6r/m;
    limit_req_zone $server_addr zone=pair_global:10m rate=30r/m;
    limit_req_zone $binary_remote_addr zone=refresh_source:10m rate=30r/m;
    limit_req_zone $server_addr zone=refresh_global:10m rate=120r/m;
    limit_req_zone $binary_remote_addr zone=ws_handshake_source:10m rate=12r/m;
    limit_req_zone $server_addr zone=ws_handshake_global:10m rate=120r/m;
    limit_conn_zone $binary_remote_addr zone=image_connection_source:10m;
    limit_conn_zone $server_addr zone=image_connection_global:10m;
    limit_conn_zone $binary_remote_addr zone=ws_connection_source:10m;
    limit_conn_zone $server_addr zone=ws_connection_global:10m;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    upstream gateway_runtime {
        server 172.31.42.3:8080 max_fails=2 fail_timeout=10s;
        keepalive 16;
    }

    server {
        listen 8080 default_server;
        server_name _;

        location = /edge-health {
            allow 127.0.0.1;
            allow ::1;
            deny all;
            access_log off;
            return 204;
        }

        location ^~ /.well-known/acme-challenge/ {
            root /var/www/acme;
            default_type text/plain;
            try_files $uri =404;
        }

        location / {
            return 308 https://__CHEBY_PUBLIC_IP__$request_uri;
        }
    }

    server {
        listen 8443 ssl default_server;
        server_name __CHEBY_PUBLIC_IP__;

        if ($host != "__CHEBY_PUBLIC_IP__") {
            return 421;
        }

        ssl_certificate /tls/current/fullchain.pem;
        ssl_certificate_key /tls/current/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:TLS:10m;
        ssl_session_timeout 10m;
        ssl_session_tickets off;

        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;

        error_page 429 = @edge_rate_limited;

        location @edge_rate_limited {
            default_type application/json;
            add_header Cache-Control "no-store" always;
            add_header Retry-After "60" always;
            return 429 '{"error":{"code":"EDGE_RATE_LIMITED","message":"Too many requests","retryable":true}}';
        }

        location = /v1/pairings/exchange {
            client_max_body_size 16k;
            limit_req zone=pair_source burst=2 nodelay;
            limit_req zone=pair_global burst=10 nodelay;
            include /etc/nginx/includes/proxy-http.conf;
        }

        location = /v1/auth/refresh {
            client_max_body_size 4k;
            limit_req zone=refresh_source burst=10 nodelay;
            limit_req zone=refresh_global burst=30 nodelay;
            include /etc/nginx/includes/proxy-http.conf;
        }

        location = /v1/events {
            client_max_body_size 1k;
            limit_req zone=ws_handshake_source burst=4 nodelay;
            limit_req zone=ws_handshake_global burst=20 nodelay;
            limit_conn ws_connection_source 4;
            limit_conn ws_connection_global 100;
            include /etc/nginx/includes/proxy-websocket.conf;
        }

        location ~ ^/v1/threads/[^/]+/turns$ {
            client_max_body_size 256k;
            limit_req zone=api_source burst=30 nodelay;
            limit_req zone=api_global burst=120 nodelay;
            include /etc/nginx/includes/proxy-http.conf;
        }

        location ~ ^/v1/threads/[^/]+/turn-inputs/[^/]+/images/[^/]+$ {
            client_max_body_size 8m;
            limit_req zone=api_source burst=30 nodelay;
            limit_req zone=api_global burst=120 nodelay;
            limit_conn image_connection_source 1;
            limit_conn image_connection_global 2;
            limit_except PUT {
                deny all;
            }
            include /etc/nginx/includes/proxy-http.conf;
        }

        location ~ ^/v1/approvals/[^/]+/decision$ {
            client_max_body_size 16k;
            limit_req zone=api_source burst=20 nodelay;
            limit_req zone=api_global burst=80 nodelay;
            include /etc/nginx/includes/proxy-http.conf;
        }

        location /v1/ {
            client_max_body_size 64k;
            limit_req zone=api_source burst=30 nodelay;
            limit_req zone=api_global burst=120 nodelay;
            include /etc/nginx/includes/proxy-http.conf;
        }

        location / {
            return 404;
        }
    }
}

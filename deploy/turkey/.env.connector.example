# Public, non-secret operator inputs. Use install_node_bootstrap.py for the
# second env file containing public Node coordinates and host secret paths.
CHEBY_CONNECTOR_IMAGE=sha256:replace-with-reviewed-local-image-id
CHEBY_CONNECTOR_DATA_DIR=/var/lib/chebycodex-connector/data
CHEBY_CODEX_HOME_DIR=/var/lib/chebycodex-connector/codex-home
CHEBY_WORKSPACE_DIR=/var/lib/chebycodex-connector/workspace
CHEBY_ASSET_STAGING_DIR=/var/lib/chebycodex-connector/asset-staging
CHEBY_PHONEBRIDGE_TOKEN_PATH=/etc/chebycodex-connector/phonebridge_local_token
CHEBY_PHONEBRIDGE_ENV_PATH=/etc/chebycodex-connector/phonebridge.env
CHEBY_PHONEBRIDGE_CERTS_DIR=/etc/chebycodex-connector/phonebridge-certs
CHEBY_CONNECTOR_MEMORY=18g
CHEBY_CONNECTOR_CPUS=8.0

FROM python:3.12-alpine3.23@sha256:601d3d3797e90e2534782e69c85fafb7971b43f24c7b1b079b7e48dd435e458d

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apk add --no-cache openssl=3.5.7-r0

COPY deploy/turkey/check-requirements.lock /tmp/check-requirements.lock
RUN pip install --no-cache-dir --require-hashes \
        --requirement /tmp/check-requirements.lock \
    && rm -f /tmp/check-requirements.lock

ENTRYPOINT ["python"]
CMD ["--version"]

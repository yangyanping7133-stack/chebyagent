# Public, non-secret deployment inputs. Never place Relay credentials or TLS
# private-key material in this file.
CHEBY_RELAY_IMAGE=sha256:replace-with-reviewed-local-relay-image-id
CHEBY_RELAY_EDGE_IMAGE=sha256:replace-with-reviewed-local-edge-image-id
CHEBY_PUBLIC_IP=203.0.113.10
# The EIP is NAT-mapped. Bind Docker to the exact local ECS address, not the EIP.
CHEBY_BIND_IP=10.0.0.10
CHEBY_RELAY_PUBLIC_PORT=27461
CHEBY_RELAY_GATE_PORT=27462
# Migration-only Quick Tunnel Host. Set empty after the fixed-IP APK cutover.
CHEBY_RELAY_LEGACY_HOST=chemicals-submission-capital-indianapolis.trycloudflare.com
CHEBY_RELAY_LOOPBACK_PORT=18080
CHEBY_RELAY_GATE_LOOPBACK_PORT=18081
# Fixed-IP cutover reuses the currently active R18 Relay SQLite bind exactly.
CHEBY_RELAY_DATA_DIR=/srv/chebycodex-r18/relay-data
CHEBY_RELAY_GATE_DATA_DIR=/var/lib/chebycodex-relay-gate/data
CHEBY_RELAY_BOOTSTRAP_DIR=/etc/chebycodex-relay/bootstrap
CHEBY_RELAY_TLS_DIR=/etc/chebycodex-relay-edge/tls
# Private UID/GID 101 staging directory populated from the offline signer.
# Candidate private keys remain mode 0400 and are only readable by the TLS UID.
CHEBY_RELAY_CERT_STAGE_DIR=/etc/chebycodex-relay-edge/staging
CHEBY_RELAY_MEMORY=1g
CHEBY_RELAY_CPUS=1.0

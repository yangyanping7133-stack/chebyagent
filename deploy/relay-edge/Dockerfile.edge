FROM nginx:1.30-alpine3.23@sha256:0d3b80406a13a767339fbe2f41406d6c7da727ab89cf8fae399e81f780f814d1

RUN /sbin/apk add --no-cache --upgrade \
        c-ares=1.34.8-r0 \
        curl=8.20.0-r0 \
        libcurl=8.20.0-r0 \
        libexpat=2.8.2-r0 \
    && rm -f /etc/nginx/conf.d/default.conf \
    && install -d -o nginx -g nginx -m 0750 /etc/nginx/includes

COPY deploy/relay-edge/edge/includes/ /etc/nginx/includes/

USER 101:101

HEALTHCHECK --interval=20s --timeout=3s --start-period=10s --retries=5 \
    CMD ["wget", "--quiet", "--output-document=-", "http://127.0.0.1:8080/edge-health"]

CMD ["nginx", "-g", "daemon off;"]
